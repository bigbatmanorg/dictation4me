{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/bigbatmanorg/dictation4me/spec/presets.schema.json",
  "title":"Default AI transform presets",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","presets"],
  "properties": {
    "schema_version":{"const":1},
    "presets":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/preset"}}
  },
  "$defs":{
    "preset":{
      "type":"object","additionalProperties":false,
      "required":["id","name","description","instruction","output_format","preserve_language"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},
        "name":{"type":"string","minLength":1,"maxLength":80},
        "description":{"type":"string","maxLength":400},
        "instruction":{"type":"string","minLength":15,"maxLength":6000},
        "output_format":{"enum":["plain","markdown"]},
        "preserve_language":{"type":"boolean"}
      }
    }
  }
}
